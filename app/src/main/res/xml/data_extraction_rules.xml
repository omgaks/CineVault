<?xml version="1.0" encoding="utf-8"?>
<!--
   FIX: same issue as backup_rules.xml — this was the untouched sample
   stub with the TODO comment still in place and nothing actually
   excluded. This is the format Android 12+ (API 31+) actually reads;
   backup_rules.xml only applies below that. Both need the same
   exclusions kept in sync — see backup_rules.xml for the full reasoning
   on which prefs are excluded and why.

   Applied to both cloud-backup (Google's servers) AND device-transfer
   (direct old-device-to-new-device transfer) — device-transfer is lower
   risk than cloud-backup, but "what's in this person's secret folder"
   still isn't something that should silently follow them to a new
   device without them choosing to set that folder up again there.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cinevault_secret.xml"/>
        <exclude domain="sharedpref" path="cinevault_secret_secure.xml"/>
        <exclude domain="sharedpref" path="cinevault_restricted_folders.xml"/>
        <exclude domain="sharedpref" path="cinevault_smb_shares.xml"/>
        <exclude domain="sharedpref" path="cinevault_smb_shares_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cinevault_secret.xml"/>
        <exclude domain="sharedpref" path="cinevault_secret_secure.xml"/>
        <exclude domain="sharedpref" path="cinevault_restricted_folders.xml"/>
        <exclude domain="sharedpref" path="cinevault_smb_shares.xml"/>
        <exclude domain="sharedpref" path="cinevault_smb_shares_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
